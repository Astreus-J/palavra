#!/usr/bin/env sh
# Bloqueia segredos: arquivos .env e padrões de chaves em mudanças em stage.
if git diff --cached --name-only | grep -Eq '(^|/)\.env($|\.)' && ! git diff --cached --name-only | grep -Eq '\.env\.example$'; then
  echo "Bloqueado: .env não pode ser commitado." >&2; exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -Eq '(suiprivkey1[a-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|[0-9]{8,10}:AA[0-9A-Za-z_-]{30,}|plane_api_[0-9a-f]{20,})'; then
  echo "Bloqueado: possível segredo (Sui/Gemini/Telegram/Plane) nas mudanças." >&2; exit 1
fi
