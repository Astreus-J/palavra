{
  "name": "palavra",
  "version": "0.1.0",
  "description": "Palavra: collective memory and a commitments ledger for group chats, built on Walrus Memory. Walrus Sessions 8.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/test.ts",
    "eval": "tsx eval/run.ts",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/seal": "^1.4.13",
    "@mysten/sui": "^2.31.3",
    "@mysten/walrus": "^1.2.28",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
