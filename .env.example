# ─── Palavra — variáveis de ambiente ─────────────────────────────────────────
# Copie para .env e preencha. O .env é ignorado pelo git: NUNCA versione segredos.

# Modo da memória: "mock" roda offline (MemWalMock, sem chaves); "real" usa mainnet.
MEMWAL_MODE=mock

# Walrus Memory (obrigatórias quando MEMWAL_MODE=real) — gere em https://memory.walrus.xyz
# A delegate key fica só no servidor.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Telegram — token do @BotFather (obrigatória para rodar o bot)
TELEGRAM_BOT_TOKEN=

# Gemini — https://aistudio.google.com (LLM principal; trilha Beyond the Big Two)
GEMINI_API_KEY=
# Modelo exato a confirmar na decisão D-05 (docs/DECISIONS.md)
GEMINI_MODEL=

# Cache local (ledger SQLite reconstruível do Walrus — decisão D-01)
DB_PATH=./data/palavra.db

# Fuso padrão dos grupos (prazos como "sexta", "amanhã")
DEFAULT_TIMEZONE=America/Sao_Paulo

# Link de prova de cada blob (recibos 🔗)
WALRUSCAN_BLOB_URL=https://walruscan.com/mainnet/blob

# Logs: fatal | error | warn | info | debug
LOG_LEVEL=info
