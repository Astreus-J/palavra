# ─── Palavra — environment variables ─────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored: NEVER commit secrets.

# Memory mode: "mock" runs offline (MemWalMock, no keys); "real" uses Walrus mainnet.
# Real writes are immutable blobs, so keep "mock" for day-to-day development.
MEMWAL_MODE=mock

# Walrus Memory (required when MEMWAL_MODE=real) — generate at https://memory.walrus.xyz
# The delegate key must stay server-side.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Telegram — bot token from @BotFather (required to run the bot)
TELEGRAM_BOT_TOKEN=

# Gemini — https://aistudio.google.com (primary LLM; "Beyond the Big Two" track)
GEMINI_API_KEY=
# Exact model is tracked in decision D-05 (docs/DECISIONS.md)
GEMINI_MODEL=
# Backup model used when the primary keeps failing (503/429) or returns invalid output. Optional.
GEMINI_FALLBACK_MODEL=

# Local cache (SQLite ledger, rebuildable from Walrus — decision D-01)
DB_PATH=./data/palavra.db

# Default timezone for groups (deadlines such as "Friday", "tomorrow")
DEFAULT_TIMEZONE=America/Sao_Paulo

# Base URL for proof links on each receipt
WALRUSCAN_BLOB_URL=https://walruscan.com/mainnet/blob

# Logs: fatal | error | warn | info | debug
LOG_LEVEL=info
