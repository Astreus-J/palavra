# ─── Recall — environment variables ─────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored: NEVER commit secrets.

# Memory mode: "mock" runs offline (MemWalMock, no keys); "real" uses Walrus mainnet.
# Real writes are immutable blobs, so keep "mock" for day-to-day development.
MEMWAL_MODE=mock

# Walrus Memory (required when MEMWAL_MODE=real) — generate at https://memory.walrus.xyz
# The delegate key must stay server-side.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Telegram — bot token from @BotFather (required to run the bot)
TELEGRAM_BOT_TOKEN=

# OpenRouter — https://openrouter.ai/keys (primary LLM; "Beyond the Big Two" track)
OPENROUTER_API_KEY=
# Comma-separated, tried in order; the next model takes over on quota exhaustion or an invalid
# answer (see callWithFallback in src/llm/extraction.ts). All free (:free or zero pricing), none
# from Anthropic/OpenAI, ordered by measured accuracy. Chain and rationale tracked in decision D-05
# (docs/DECISIONS.md). The OpenRouter account itself is capped at 50 free requests/day unless $10
# in credits is added (raises it to 1000/day) — see D-05 before relying on this in real usage.
OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Local cache (SQLite ledger, rebuildable from Walrus — decision D-01)
DB_PATH=./data/recall.db

# Default timezone for groups (deadlines such as "Friday", "tomorrow")
DEFAULT_TIMEZONE=America/Sao_Paulo

# Hour of the day (0-23, in the group timezone) from which deadline reminders are sent
REMINDER_HOUR=9

# Base URL for proof links on each receipt
WALRUSCAN_BLOB_URL=https://walruscan.com/mainnet/blob

# Logs: fatal | error | warn | info | debug
LOG_LEVEL=info

# Plane (self-hosted task board — tooling/scripts only, not read by the bot itself)
PLANE_API_KEY=
PLANE_BASE_URL=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
